# pulse-viewer environment (example) — copy to viewer.env, never commit the real one.

# ---- HTTP server --------------------------------------------------------------
PULSE_LISTEN=:8080
# PULSE_LOG_LEVEL=info

# ---- History (viewer owns it; see docs/brainstorm.md D3) ----------------------
PULSE_DB=/var/lib/pulse/pulse.db
# Raw results, then rollups. 100 targets @30s ≈ 30-40 MB/day of raw rows.
PULSE_RETENTION_RAW=168h        # 7d
PULSE_RETENTION_1M=720h         # 30d
PULSE_RETENTION_1H=8760h        # 365d

# ---- UI login (Basic auth — TLS termination required in front) ----------------
PULSE_AUTH_USER=admin
PULSE_AUTH_PASSWORD=change-me
# Preferred over the plain value if you have bcrypt handy:
# PULSE_AUTH_PASSWORD_HASH=$2y$10$...

# ---- Ingest (probers → viewer) -----------------------------------------------
# Shared secret, generated e.g. with: openssl rand -hex 32
PULSE_INGEST_TOKEN=replace-with-a-long-random-value

# ---- Silence detection -------------------------------------------------------
# Probers that should check in. One that never does shows as MISSING instead of
# simply not existing. Targets of a silent prober go STALE, never DOWN.
PULSE_EXPECTED_PROBERS=prober-lan-a,prober-lan-b,prober-cloud
# PULSE_STALE_AFTER=30s         # default: 3 x the prober's push interval

# ---- Prometheus (optional; the viewer can be scraped too) --------------------
# PULSE_METRICS_LISTEN=:8081
