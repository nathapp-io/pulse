# Copy to .env for `docker compose up`. Never commit the real file.
#
#   openssl rand -hex 32     # good value for PULSE_INGEST_TOKEN

PULSE_AUTH_USER=admin
PULSE_AUTH_PASSWORD=change-me
PULSE_INGEST_TOKEN=replace-with-a-long-random-value

# Host port for the viewer UI/API (default 8080).
# PULSE_PORT=8080
